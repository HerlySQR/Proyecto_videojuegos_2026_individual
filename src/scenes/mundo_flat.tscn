[sub_resource type="Shader" id="Shader_unrlv"]
code = "shader_type spatial;
render_mode blend_mix, depth_draw_opaque, cull_back, diffuse_burley, specular_disabled;

uniform sampler2D fow_viewport_texture: source_color, filter_linear;
uniform sampler2D albedo_texture: source_color, filter_nearest_mipmap_anisotropic, repeat_enable;
uniform float fow_range_min = 0.01;
uniform float fow_range_max = 0.99;

uniform vec3 uv1_scale;
uniform vec3 uv1_offset;

void vertex() {
	UV = UV * uv1_scale.xy + uv1_offset.xy;
}

void fragment() {
	vec4 fow_data = texture(fow_viewport_texture, UV);
	vec4 albedo_tex = texture(albedo_texture, UV);
	
	float is_explored = smoothstep(fow_range_min, fow_range_max, fow_data.g);
	float is_visible = smoothstep(fow_range_min, fow_range_max, fow_data.r);
	
	float visiblity = mix(is_explored * 0.3, 1.0, is_visible);
	
	ALBEDO = albedo_tex.rgb * visiblity;
}

//void light() {
//	// Called for every pixel for every light affecting the material.
//	// Uncomment to replace the default light processing function with this one.
//}
"

